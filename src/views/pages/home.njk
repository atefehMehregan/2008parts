{% extends "layouts/base.njk" %}

{# ============================================================================
   صفحهٔ اصلی فروشگاه.

   هر بخش فقط وقتی رندر می‌شود که دادهٔ واقعی داشته باشد. هیچ کارت نمونه،
   هیچ محصول ساختگی و هیچ عدد تزئینی‌ای اینجا نیست: با کاتالوگ خالی،
   صفحه همچنان یک فروشگاه کامل به نظر می‌رسد و صادقانه می‌گوید هنوز
   محصولی ثبت نشده است.
   ========================================================================= #}

{% block content %}

{# --------------------------------------------------------------- هیرو

   چیدمان دو ستونی و راست‌به‌چپ: متن از سمت راست (شروعِ خواندن فارسی)
   و تصویر در سمت چپ. این آینهٔ مکانیکیِ یک قالب چپ‌به‌راست نیست —
   متن جایی است که چشم فارسی‌زبان اول نگاه می‌کند.

   ⚠️ جای تصویر عمدا خالیِ طراحی‌شده است، نه فراموش‌شده: هیچ تصویر
   اتومبیلی در پروژه نیست و ساختن یا برداشتنِ یکی از جای دیگر درست
   نبود. وقتی تصویر رسید، فقط همین یک بلوک عوض می‌شود و بقیهٔ چیدمان
   دست‌نخورده می‌ماند. #}
<section class="hero">
  <div class="container hero__inner">

    <div class="hero__copy">
      {% if heroOffer %}
        <p class="hero__eyebrow"><span class="hero__tag">پیشنهاد ویژه</span> ۲۰۰۸پارتس</p>
      {% endif %}

      <h1 class="hero__title">قطعات و لوازم جانبی پژو ۲۰۰۸</h1>
      <p class="hero__lede">
        قطعه را با نام فارسی، کد کالا یا شماره فنی روی خودِ قطعه پیدا کنید.
      </p>

      <form class="hero__search site-search" action="/search" method="get" role="search">
        <label class="sr-only" for="hero-search-input">جست‌وجوی قطعه</label>
        <input class="site-search__input" id="hero-search-input" type="search" name="q"
               placeholder="مثلا: فیلتر روغن یا ۹۶۷۸۱۹۱۵۸۰" />
        <button class="site-search__button" type="submit">جست‌وجو</button>
      </form>

      <div class="hero__actions">
        <a class="btn btn--primary" href="/products">دیدن همهٔ محصولات</a>
        {% if categoryList.length %}
          <a class="btn btn--ghost" href="#categories">مرور دسته‌بندی‌ها</a>
        {% endif %}
      </div>
    </div>

    <div class="hero__visual">
      {% if heroOffer %}
        {# کارت پیشنهاد — محصول واقعیِ کاتالوگ، با قیمت واقعیِ همان ردیف. #}
        <a class="hero__offer" href="/product/{{ heroOffer.slug | urlencode }}">
          <span class="hero__offer-media">
            <picture>
              <source type="image/webp" srcset="/media/products/{{ heroOffer.primary_image_id }}/card.webp" />
              <img src="/media/products/{{ heroOffer.primary_image_id }}/card.jpg"
                   alt="{{ heroOffer.name }}" width="400" height="533" loading="eager" />
            </picture>
          </span>
          <span class="hero__offer-body">
            {% if heroOffer.brand_name %}
              <span class="hero__offer-brand">{{ heroOffer.brand_name }}</span>
            {% endif %}
            <span class="hero__offer-name">{{ heroOffer.name }}</span>
            {% if heroOffer.price_toman %}
              <span class="hero__offer-price">
                {% if heroOffer.sale_price_toman %}
                  <strong class="num">{{ heroOffer.sale_price_toman | toman }}</strong>
                  <del class="num">{{ heroOffer.price_toman | tomanPlain }}</del>
                {% else %}
                  <strong class="num">{{ heroOffer.price_toman | toman }}</strong>
                {% endif %}
              </span>
            {% endif %}
            <span class="hero__offer-cta">مشاهدهٔ محصول</span>
          </span>
        </a>
      {% else %}
        <div class="hero__visual-empty" aria-hidden="true"></div>
      {% endif %}
    </div>

  </div>
</section>

{# -------------------------------------------------------- دسته‌بندی‌ها #}
{% if categoryList.length %}
<section class="home-section home-section--tint" id="categories">
  <div class="container">
    <div class="home-section__head">
      <div>
        <h2 class="home-section__title">دسته‌بندی‌ها</h2>
        <p class="home-section__text">از دسته شروع کنید یا مستقیم جست‌وجو کنید.</p>
      </div>
      <a class="home-section__link" href="/products">همهٔ محصولات</a>
    </div>

    <div class="category-grid">
      {% for c in categoryList %}
        <a class="category-card" href="/category/{{ c.slug | urlencode }}">
          <span class="category-card__name">{{ c.name }}</span>
          <span class="category-card__count num">{{ c.product_count | faDigits }}</span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{# ------------------------------------------------------ قفسهٔ «ویژه» #}
{% if featuredItems.length %}
<section class="home-section">
  <div class="container">
    <div class="home-section__head">
      <h2 class="home-section__title">محصولات ویژه</h2>
      <a class="home-section__link" href="/products">دیدن همه</a>
    </div>
    <div class="product-grid">
      {% for item in featuredItems %}{% include "partials/product-card.njk" %}{% endfor %}
    </div>
  </div>
</section>
{% endif %}

{# ------------------------------------------------------- قفسهٔ «تازه» #}
{% if freshItems.length %}
<section class="home-section">
  <div class="container">
    <div class="home-section__head">
      <h2 class="home-section__title">تازه به کاتالوگ اضافه شد</h2>
      <a class="home-section__link" href="/products?sort=newest">دیدن همه</a>
    </div>
    <div class="product-grid">
      {% for item in freshItems %}{% include "partials/product-card.njk" %}{% endfor %}
    </div>
  </div>
</section>
{% endif %}

{# ------------------------------------------------- قفسهٔ «تازه‌ترین» #}
{# فقط وقتی هیچ محصول ویژه یا تازه‌ای علامت نخورده باشد؛ وگرنه همان
   محصول‌ها دو بار پشت سر هم تکرار می‌شدند. #}
{% if latestItems.length %}
<section class="home-section">
  <div class="container">
    <div class="home-section__head">
      <div>
        <h2 class="home-section__title">تازه‌ترین محصول‌ها</h2>
        <p class="home-section__text">
          <span class="num">{{ totalProducts | faDigits }}</span> محصول در کاتالوگ
        </p>
      </div>
      <a class="home-section__link" href="/products">دیدن همه</a>
    </div>
    <div class="product-grid">
      {% for item in latestItems %}{% include "partials/product-card.njk" %}{% endfor %}
    </div>
  </div>
</section>
{% endif %}

{# --------------------------------------------------- کاتالوگ خالی #}
{% if catalogueEmpty %}
<section class="home-section">
  <div class="container">
    {% set emptyTitle = 'هنوز محصولی ثبت نشده است' %}
    {% set emptyText = 'کاتالوگ در حال آماده‌سازی است. به‌زودی قطعات پژو ۲۰۰۸ اینجا نمایش داده می‌شوند.' %}
    {% set emptyActionUrl = '/products' %}
    {% set emptyActionLabel = 'دیدن صفحهٔ محصولات' %}
    {% include "partials/empty-state.njk" %}
  </div>
</section>
{% endif %}

{# ------------------------------------------------------------ برندها #}
{% if brandList.length %}
<section class="home-section">
  <div class="container">
    <div class="home-section__head">
      <h2 class="home-section__title">برندها</h2>
    </div>
    <div class="brand-strip">
      {% for b in brandList %}
        <a class="brand-chip" href="/brand/{{ b.slug | urlencode }}">{{ b.name }}</a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{# ------------------------------------------------------- چرا اینجا #}
{# فقط توانایی‌های واقعی همین نسخه. هیچ ادعایی دربارهٔ ارسال، گارانتی
   یا پشتیبانی — چون هیچ‌کدام هنوز پیاده نشده‌اند. #}
<section class="home-section home-section--tint">
  <div class="container">
    <div class="home-section__head">
      <h2 class="home-section__title">کار کردن با این کاتالوگ</h2>
    </div>
    <div class="value-grid">
      <div class="value-card">
        <h3 class="value-card__title">جست‌وجو با شماره فنی</h3>
        <p class="value-card__text">
          شماره فنی را همان‌طور که روی قطعه نوشته شده وارد کنید؛ خط تیره،
          فاصله و رقم فارسی فرقی نمی‌کند.
        </p>
      </div>
      <div class="value-card">
        <h3 class="value-card__title">فقط پژو ۲۰۰۸</h3>
        <p class="value-card__text">
          کاتالوگ روی قطعات همین خودرو متمرکز است، نه یک فروشگاه عمومی
          با هزاران قطعهٔ بی‌ربط.
        </p>
      </div>
      <div class="value-card">
        <h3 class="value-card__title">اطلاعات سازگاری</h3>
        <p class="value-card__text">
          هر قطعه می‌تواند یادداشت سازگاری و فهرست خودروهای سازگار داشته
          باشد تا پیش از خرید مطمئن شوید.
        </p>
      </div>
      <div class="value-card">
        <h3 class="value-card__title">فارسی و شفاف</h3>
        <p class="value-card__text">
          نام قطعه، دسته‌بندی و نشانی صفحه‌ها فارسی است و قیمت‌ها با رقم
          فارسی و واحد تومان نمایش داده می‌شوند.
        </p>
      </div>
    </div>
  </div>
</section>

{# ---------------------------------------------------------- فراخوان #}
<section class="section">
  <div class="container">
    <div class="cta-band">
      <div>
        <h2 class="cta-band__title">دنبال قطعهٔ مشخصی هستید؟</h2>
        <p class="cta-band__text">
          کل کاتالوگ را ببینید یا نام قطعه، کد کالا و شماره فنی را در کادر
          جست‌وجوی بالای صفحه بنویسید.
        </p>
      </div>
      <a class="btn btn--onDark" href="/products">رفتن به کاتالوگ</a>
    </div>
  </div>
</section>

{% endblock %}
