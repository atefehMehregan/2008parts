{% extends "layouts/base.njk" %}

{# ============================================================================
   صفحهٔ جزئیات محصول.

   دکمهٔ «افزودن به سبد خرید» اینجاست و به سبد مهمان وصل است
   (services/cart.js). پرداخت آنلاین وجود ندارد و قرار هم نیست باشد:
   سبد انتخاب مشتری را جمع می‌کند و او را به تماس با فروشنده می‌رساند.

   فرم هیچ قیمتی نمی‌فرستد — فقط کد کالا و تعداد.
   ========================================================================= #}

{% block content %}
<section class="section">
  <div class="container">
    {% set crumbs = [
      { label: 'خانه', url: '/' },
      { label: 'محصولات', url: '/products' },
      { label: product.category_name, url: '/category/' + (product.category_slug | urlencode) },
      { label: product.name }
    ] %}
    {% include "partials/breadcrumb.njk" %}

    <div class="product-detail">
      {# ---------------------------------------------------------- گالری #}
      <div class="product-detail__media">
        {% if images.length %}
          {% set main = images[0] %}
          <picture>
            <source type="image/webp" srcset="/media/products/{{ main.image_id }}/detail.webp" />
            <img class="product-detail__image"
                 src="/media/products/{{ main.image_id }}/detail.jpg"
                 alt="{{ main.alt_text or product.name }}"
                 width="800" height="800" />
          </picture>

          {% if images.length > 1 %}
            <ul class="thumb-list">
              {% for img in images %}
                <li>
                  <picture>
                    <source type="image/webp" srcset="/media/products/{{ img.image_id }}/thumb.webp" />
                    <img src="/media/products/{{ img.image_id }}/thumb.jpg"
                         alt="{{ img.alt_text or product.name }}"
                         width="160" height="160" loading="lazy" />
                  </picture>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        {% else %}
          <div class="product-detail__placeholder">
            {# برچسب فقط از دادهٔ موجودِ محصول: نام دسته. #}
            {% set phLabel = product.category_name %}
            {% include "partials/media-placeholder.njk" %}
          </div>
          <p class="note">تصویر این محصول هنوز بارگذاری نشده است.</p>
        {% endif %}
      </div>

      {# ----------------------------------------------------------- متن #}
      <div class="product-detail__body">
        {% if product.brand_name %}
          <p class="product-detail__brand">
            <a href="/brand/{{ product.brand_slug | urlencode }}">{{ product.brand_name }}</a>
          </p>
        {% endif %}

        <h1 class="product-detail__title">{{ product.name }}</h1>

        {% if product.short_description %}
          <p class="product-detail__lede">{{ product.short_description }}</p>
        {% endif %}

        <div class="buy-card">
          <div class="buy-card__price">
            {% if not product.price_toman %}
              {# قیمت فروشگاهی هنوز ثبت نشده — هیچ عددی به‌جای آن نمی‌نشیند. #}
              <strong class="price__now">استعلام قیمت</strong>
            {% elif product.sale_price_toman %}
              <strong class="price__now num">{{ product.sale_price_toman | toman }}</strong>
              <del class="price__old num">{{ product.price_toman | tomanPlain }}</del>
              {% if discountPercent > 0 %}
                <span class="badge badge--sale num">{{ discountPercent | faDigits }}٪ تخفیف</span>
              {% endif %}
            {% else %}
              <strong class="price__now num">{{ product.price_toman | toman }}</strong>
            {% endif %}
          </div>

          <div class="buy-card__row">
            {# قطعه‌ای که هنوز دادهٔ تجاری ندارد، هیچ وضعیتی اعلام نمی‌کند:
               نه «موجود»، نه «قابل سفارش» — چون هیچ‌کدام تأیید نشده است. #}
            {% if product.stock_qty > 0 %}
              <span class="availability availability--in">موجودی: <span class="num">{{ product.stock_qty | faDigits }}</span> عدد</span>
            {% elif not product.price_toman %}
              <span class="availability availability--order">استعلام موجودی</span>
            {% elif product.availability == 'in_stock' %}
              <span class="availability availability--in">موجود</span>
            {% elif product.availability == 'on_order' %}
              <span class="availability availability--order">قابل سفارش</span>
            {% elif product.availability == 'discontinued' %}
              <span class="availability availability--out">تولید متوقف شده</span>
            {% else %}
              <span class="availability availability--out">ناموجود</span>
            {% endif %}
            <span>کد کالا: <bdi class="part-number">{{ product.sku }}</bdi></span>
          </div>

          <div class="buy-card__row">
            {# ⚠️ این فرم فقط کد کالا و تعداد می‌فرستد. قیمت اینجا نیست و
               نباید باشد: سرور قیمت را از پایگاه داده می‌خواند، پس هیچ
               فیلدی در این صفحه نمی‌تواند قیمت را عوض کند.

               برای قطعه‌ای که قیمتش ثبت نشده هم افزودن به سبد کار می‌کند:
               مشتری قطعه را جمع می‌کند و قیمتش را هنگام تماس استعلام
               می‌کند. سبد چنین قلمی را «استعلام قیمت» نشان می‌دهد و در
               جمع کل نمی‌آورد. #}
            {% if product.availability == 'discontinued' %}
              <p class="info-note">
                تولید این قطعه متوقف شده است. برای یافتن جایگزین، کد کالا یا
                شماره فنی بالا را هنگام تماس اعلام کنید.
              </p>
            {% else %}
              <form class="add-to-cart" action="/cart/add" method="post">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                <input type="hidden" name="sku" value="{{ product.sku }}" />

                <label class="sr-only" for="add-qty">تعداد</label>
                {# dir=ltr روی خودِ ورودی عددی: در متن راست‌به‌چپ، مکان‌نما
                   و علامت‌های افزایش/کاهش وگرنه جابه‌جا دیده می‌شوند. #}
                <input class="add-to-cart__qty num" id="add-qty" name="qty"
                       type="number" inputmode="numeric" dir="ltr"
                       value="1" min="1" max="99" step="1" />

                <button class="btn add-to-cart__btn" type="submit">افزودن به سبد خرید</button>
              </form>

              {% if not product.price_toman %}
                <p class="info-note">
                  قیمت این قطعه هنوز ثبت نشده و باید استعلام شود. می‌توانید آن
                  را به سبد اضافه کنید و قیمتش را هنگام تماس بپرسید.
                </p>
              {% else %}
                <p class="info-note">
                  پرداخت آنلاین وجود ندارد؛ سفارش با تماس تلفنی نهایی می‌شود.
                </p>
              {% endif %}
            {% endif %}
          </div>
        </div>

        <dl class="spec-table">
          <div class="spec-table__row">
            <dt>کد کالا</dt>
            <dd><bdi class="part-number">{{ product.sku }}</bdi></dd>
          </div>
          {% if product.oem_number %}
            <div class="spec-table__row">
              <dt>شماره فنی</dt>
              <dd><bdi class="part-number">{{ product.oem_number }}</bdi></dd>
            </div>
          {% endif %}
          <div class="spec-table__row">
            <dt>دسته‌بندی</dt>
            <dd><a href="/category/{{ product.category_slug | urlencode }}">{{ product.category_name }}</a></dd>
          </div>
          <div class="spec-table__row">
            <dt>وضعیت</dt>
            <dd>
              {% if product.stock_qty > 0 %}<span class="num">{{ product.stock_qty | faDigits }}</span> عدد موجود
              {% elif not product.price_toman %}استعلام موجودی
              {% elif product.availability == 'in_stock' %}موجود
              {% elif product.availability == 'on_order' %}قابل سفارش
              {% elif product.availability == 'discontinued' %}تولید متوقف شده
              {% else %}ناموجود{% endif %}
            </dd>
          </div>
          {% for s in specs %}
            <div class="spec-table__row">
              <dt>{{ s.key }}</dt>
              <dd>{{ s.value }}</dd>
            </div>
          {% endfor %}
        </dl>

        {% if product.compatibility_note or vehicles.length %}
          <section class="product-block">
            <h2 class="product-block__title">سازگاری</h2>
            {% if product.compatibility_note %}
              <div class="product-block__body">{{ product.compatibility_note }}</div>
            {% endif %}
            {% if vehicles.length %}
              <ul class="compat__list">
                {% for v in vehicles %}
                  <li>{{ v.display_name }}{% if v.note %} — {{ v.note }}{% endif %}</li>
                {% endfor %}
              </ul>
            {% endif %}
          </section>
        {% endif %}
      </div>
    </div>

    {% if product.description %}
      <section class="product-block">
        <h2 class="product-block__title">توضیحات</h2>
        <div class="product-block__body">{{ product.description }}</div>
      </section>
    {% endif %}
  </div>
</section>
{% endblock %}
