{% extends "layouts/base.njk" %}

{# ============================================================================
   تماس با ما.

   ⚠️ هیچ راه ارتباطی اینجا ساخته نمی‌شود. کنترلر فقط کانال‌هایی را
   می‌فرستد که در config.contact مقدار واقعی دارند (از متغیرهای محیطی
   STORE_PHONE، STORE_EMAIL، STORE_ADDRESS و مانند آن‌ها).

   امروز هیچ‌کدام مقدار ندارند، پس صفحه صادقانه همین را می‌گوید. شمارهٔ
   تلفن یا نشانیِ نمونه گذاشتن از خالی گذاشتن بدتر است: کسی ممکن است
   واقعا با آن تماس بگیرد.

   برای پر کردن، فقط همان متغیرهای محیطی را بدهید؛ این قالب و کنترلر
   تغییری لازم ندارند.
   ========================================================================= #}

{% block content %}
<section class="section">
  <div class="container">
    {% set crumbs = [
      { label: 'خانه', url: '/' },
      { label: 'تماس با ما' }
    ] %}
    {% include "partials/breadcrumb.njk" %}

    <div class="prose">
      <h1 class="page-title">تماس با ما</h1>

      {% if hasAnyChannel %}
        <p class="prose__lead">
          برای پرسش دربارهٔ یک قطعه، موجودی یا قیمت، از راه‌های زیر با
          ۲۰۰۸پارتس در تماس باشید.
        </p>

        <dl class="contact-list">
          {% for ch in channels %}
            <div class="contact-list__row">
              <dt>{{ ch.label }}</dt>
              <dd>
                {% if ch.href %}
                  {# bdi برای شماره و نشانی لاتین لازم است: بدون آن، رقم‌ها
                     و نشانی در متن راست‌به‌چپ جابه‌جا دیده می‌شوند. #}
                  <a href="{{ ch.href }}"><bdi{% if ch.isNum %} class="num"{% endif %}>{{ ch.value }}</bdi></a>
                {% else %}
                  <bdi{% if ch.isNum %} class="num"{% endif %}>{{ ch.value }}</bdi>
                {% endif %}
              </dd>
            </div>
          {% endfor %}
        </dl>
      {% else %}
        {# حالت امروز: هیچ کانالی ثبت نشده. #}
        <div class="notice notice--quiet">
          <p>
            راه‌های ارتباطی ۲۰۰۸پارتس هنوز در این صفحه ثبت نشده‌اند.
          </p>
          <p>
            عمدا شمارهٔ تماس یا نشانیِ نمونه‌ای اینجا گذاشته نشده است؛ به‌محض
            نهایی شدن، همین‌جا اعلام می‌شود.
          </p>
        </div>

        <h2>تا آن زمان</h2>
        <p>
          برای پیدا کردن قطعه نیازی به تماس نیست: قطعه را با نام فارسی، کد
          کالا یا شمارهٔ فنی
          <a href="/search">جست‌وجو کنید</a>،
          یا
          <a href="/products">فهرست کامل قطعات</a>
          را مرور کنید. موجودی و قیمت هر قطعه روی کارت خودش نوشته شده است.
        </p>
      {% endif %}

      <h2>سفارش آنلاین</h2>
      <p>
        ثبت سفارش و پرداخت اینترنتی هنوز روی این سایت پیاده‌سازی نشده است.
        توضیح بیشتر در <a href="/about">دربارهٔ ما</a>.
      </p>
    </div>
  </div>
</section>
{% endblock %}
