{# کارت محصول — در فهرست، دسته، برند، جست‌وجو و صفحهٔ اصلی یکسان است.
   کل کارت یک پیوند است، پس هدفِ لمس در موبایل بزرگ می‌ماند. #}
<article class="product-card">
  <a class="product-card__link" href="/product/{{ item.slug | urlencode }}">
    <div class="product-card__media">
      {% if item.primary_image_id %}
        <picture>
          <source type="image/webp" srcset="/media/products/{{ item.primary_image_id }}/card.webp" />
          <img src="/media/products/{{ item.primary_image_id }}/card.jpg"
               alt="{{ item.name }}" width="400" height="533" loading="lazy" />
        </picture>
      {% else %}
        {# تصویری هنوز بارگذاری نشده — جای آن نگه داشته می‌شود تا چیدمان نپرد.
           برچسب از دادهٔ موجودِ همین محصول می‌آید (نام دسته)؛ هیچ مشخصهٔ
           فنی، شماره فنی یا برندی ساخته نمی‌شود. #}
        {% set phLabel = item.category_name %}
        {% include "partials/media-placeholder.njk" %}
      {% endif %}

      {% if item.sale_price_toman %}
        <span class="badge badge--sale">حراج</span>
      {% elif item.is_new %}
        <span class="badge badge--new">جدید</span>
      {% endif %}
    </div>

    <div class="product-card__body">
      {% if item.brand_name %}<p class="product-card__brand">{{ item.brand_name }}</p>{% endif %}
      <h3 class="product-card__name">{{ item.name }}</h3>

      {% if item.oem_number %}
        <p class="product-card__oem">شماره فنی: <bdi class="part-number">{{ item.oem_number }}</bdi></p>
      {% endif %}

      <div class="product-card__foot">
        <div class="price">
          {% if not item.price_toman %}
            {# قیمت فروشگاهی هنوز ثبت نشده. «۰ تومان» نشان داده نمی‌شود،
               چون عددِ صفر برای مشتری یعنی رایگان — و این دروغ است.
               کلاس num عمدا نیست: این متن است، نه رقم.
               برچسب «قیمت:» اینجا نمی‌آید تا «قیمت: استعلام قیمت» نشود. #}
            <strong class="price__now">استعلام قیمت</strong>
          {% else %}
            <span class="price__label">قیمت:</span>
            {% if item.sale_price_toman %}
              <strong class="price__now num">{{ item.sale_price_toman | toman }}</strong>
              <del class="price__old num">{{ item.price_toman | tomanPlain }}</del>
            {% else %}
              <strong class="price__now num">{{ item.price_toman | toman }}</strong>
            {% endif %}
          {% endif %}
        </div>

        {# موجودی و وضعیت روی کارتِ فهرست نشان داده نمی‌شوند.
           پیش از این یک نشانِ موجودی اینجا بود (شمار واقعی، و در نبودش
           یکی از برچسب‌های وضعیت). آگاهانه برداشته شد: تصمیمِ نمایش است،
           نه تغییرِ داده.

           ⚠️ هیچ چیزی در لایهٔ داده عوض نشده. ستون‌های stock_qty و
           availability سر جایشان‌اند، مخزن همان‌طور که بود آن‌ها را
           برمی‌گرداند، فیلترِ «وضعیت موجودی» در نوار پالایش کار می‌کند،
           سقفِ تعداد در سبد همان موجودی است، و صفحهٔ محصول و بخش مدیر
           دست‌نخورده‌اند. فقط این کارت دیگر چیزی ادعا نمی‌کند. #}
      </div>
    </div>
  </a>
</article>
