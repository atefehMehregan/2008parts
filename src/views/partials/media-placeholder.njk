{# ============================================================================
   جای تصویر محصول — 2008parts

   چرا این شکل؟

     * SVG درون‌خط است، نه فایل بیرونی و نه تصویر hotlink‌شده. هیچ
       درخواست شبکه‌ای اضافه نمی‌کند و هرگز «تصویر خراب» نشان نمی‌دهد.
     * viewBox مربع ۴۰۰×۴۰۰ دارد و دقیقا همان جعبه‌ای را پر می‌کند که
       تصویر واقعی پر می‌کند، پس با آمدن عکس واقعی چیدمان نمی‌پرد.
     * متن داخل خودِ SVG است، پس با اندازهٔ کارت مقیاس می‌شود و در
       موبایل هم خوانا می‌ماند — بدون container query و بدون جاوااسکریپت.
     * رنگ‌ها از توکن‌های همین پروژه می‌آیند (base.css)، پس با پوسته
       هماهنگ می‌ماند.

   این «عکس محصول جعلی» نیست و نباید باشد: طرح خطی و تایپوگرافی روشن
   می‌گوید هنوز عکس واقعی نیامده است.

   ورودی اختیاری:
     phLabel — برچسب کوچک زیر عنوان. فراخوان آن را پیش از include ست
               می‌کند و فقط از دادهٔ موجودِ محصول می‌آید (نام دسته).
               هیچ مشخصهٔ فنی، شماره فنی یا برندی اینجا ساخته نمی‌شود.
   ========================================================================= #}
<svg class="ph" viewBox="0 0 400 533" preserveAspectRatio="xMidYMid meet"
     xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  {# بوم ۳:۴ شد تا با قاب کارت (aspect-ratio 3/4) یکی باشد.
     محتوای قبلی برای بوم ۴۰۰×۴۰۰ چیده شده بود، پس داخل یک گروه
     ۶۶ پیکسل پایین می‌آید تا دقیقا وسط بماند: (۵۳۳−۴۰۰)÷۲. #}
  <rect class="ph__bg" x="0" y="0" width="400" height="533" />
  <g transform="translate(0 66)">

  {# نشان شش‌ضلعی پروژه — همان هندسهٔ logo-mark.svg، کم‌رنگ و تزئینی،
     *وسط‌چین* پشت همه‌چیز. دارایی خودِ 2008parts است، نه نشان شخص ثالث.
     مرکز مسیر در فضای خودش (۳۲،۳۲) است، پس translate(200-32s) آن را
     دقیقا وسط بوم می‌نشاند و هیچ لبه‌ای بریده نمی‌شود. #}
  <g class="ph__mark" transform="translate(72 72) scale(4)">
    <path fill-rule="evenodd" d="
      M62 32 L47 57.98 L17 57.98 L2 32 L17 6.02 L47 6.02 Z
      M27 16 L37 16 L44.5 26 L19.5 26 Z
      M22.5 30 h19 a4.5 4.5 0 0 1 0 9 h-19 a4.5 4.5 0 0 1 0 -9 z
      M8 32.5 h3.5 a2 2 0 0 1 0 4 h-3.5 a2 2 0 0 1 0 -4 z
      M52.5 32.5 h3.5 a2 2 0 0 1 0 4 h-3.5 a2 2 0 0 1 0 -4 z" />
  </g>

  {# نماد دسته — خطی و خنثا. هر مسیر در فضای ۲۴×۲۴ کشیده شده و اینجا
     به مرکز بالا منتقل و بزرگ می‌شود. #}
  <g class="ph__icon" transform="translate(200 176) scale(3.9) translate(-12 -12)">
    {% if phLabel == 'فیلتر و سرویس' %}
      {# فیلتر: استوانهٔ پلیسه‌دار #}
      <path d="M7 5h10v14H7z" /><path d="M7 5c0 1.1 2.2 2 5 2s5-.9 5-2" />
      <path d="M9.5 8v8M12 8v8M14.5 8v8" />
    {% elif phLabel == 'موتور و توربو' %}
      {# توربو: پروانه #}
      <circle cx="12" cy="12" r="3.2" />
      <path d="M12 3.5a8.5 8.5 0 0 1 7.4 4.3M19.4 16.2A8.5 8.5 0 0 1 12 20.5M4.6 16.2A8.5 8.5 0 0 1 4.6 7.8" />
      <path d="M14.4 9.6 19 6.6M14.9 14.4l4.8 2.2M9.1 14.4l-4.8 2.2" />
    {% elif phLabel == 'ترمز' %}
      {# دیسک ترمز #}
      <circle cx="12" cy="12" r="8.5" /><circle cx="12" cy="12" r="3" />
      <path d="M12 3.5v3M12 17.5v3M20.5 12h-3M6.5 12h-3" />
    {% elif phLabel == 'تعلیق و فرمان' %}
      {# فنر کمک #}
      <path d="M12 3v3M12 18v3" />
      <path d="M8 7h8l-8 2.6h8l-8 2.6h8l-8 2.6h8" />
    {% elif phLabel == 'خنک‌کاری و تهویه' %}
      {# رادیاتور #}
      <rect x="4" y="5" width="16" height="14" rx="1.5" />
      <path d="M8 5v14M12 5v14M16 5v14" />
    {% elif phLabel == 'برق و سنسورها' %}
      {# جرقه/برق #}
      <path d="M13.5 3 6.5 13.5h4.2L10 21l7.5-11h-4.4z" />
    {% elif phLabel == 'سوخت‌رسانی' %}
      {# قطره سوخت #}
      <path d="M12 3.5c3.6 4.2 5.5 7 5.5 9.6A5.5 5.5 0 0 1 6.5 13c0-2.6 1.9-5.4 5.5-9.5z" />
    {% elif phLabel == 'روشنایی' %}
      {# چراغ با پرتو #}
      <path d="M4.5 8.5h6a5 5 0 0 1 0 7h-6z" />
      <path d="M15.5 9.5h4M15.5 12h5M15.5 14.5h4" />
    {% elif phLabel == 'برف‌پاک‌کن و شیشه‌شویی' %}
      {# تیغهٔ برف‌پاک‌کن #}
      <path d="M4 18.5 18.5 6" /><path d="M6.5 16.2l2.2 2.3M10 12.8l2.2 2.3M13.5 9.4l2.2 2.3" />
    {% elif phLabel == 'بدنه و بیرونی' %}
      {# آینهٔ بغل #}
      <path d="M4.5 9.5c3.5-2.5 8-2.8 11.5-1.2v6c-3.5 1.6-8 1.3-11.5-1.2z" />
      <path d="M16 8.3h2.2a1.3 1.3 0 0 1 1.3 1.3v3.6" />
    {% else %}
      {# پیش‌فرض: چرخ‌دنده — قطعهٔ عمومی #}
      <circle cx="12" cy="12" r="3.5" />
      <path d="M12 2.5v3M12 18.5v3M21.5 12h-3M5.5 12h-3M18.7 5.3l-2.1 2.1M7.4 16.6l-2.1 2.1M18.7 18.7l-2.1-2.1M7.4 7.4 5.3 5.3" />
    {% endif %}
  </g>

  <text class="ph__title" x="200" y="278" text-anchor="middle" direction="rtl">قطعه یدکی پژو ۲۰۰۸</text>

  {% if phLabel %}
    <text class="ph__label" x="200" y="312" text-anchor="middle" direction="rtl">{{ phLabel }}</text>
  {% endif %}

  <text class="ph__brand" x="200" y="360" text-anchor="middle">2008parts</text>
  </g>
</svg>
