{# ============================================================================
   سه دکمهٔ شناور ارتباط — اینستاگرام، واتس‌اپ، تماس.

   * هیچ ابزارک شخص ثالثی اینجا نیست و هیچ اسکریپتی بار نمی‌شود. سه
     پیوند ساده‌اند با CSS خودِ پروژه، پس با CSP (script-src 'self' و
     بدون اسکریپت) سازگارند و چیزی را ردگیری نمی‌کنند.

   * نماد‌ها SVG درون‌خط‌اند، نه فونت آیکون و نه تصویر بیرونی: یک
     درخواست شبکه اضافه نمی‌کنند و با رنگ متن هماهنگ می‌شوند.

   * هر سه برچسب دسترس‌پذیر دارند. معنا فقط با نماد منتقل نمی‌شود:
     aria-label متن کامل را می‌گوید و title برای اشاره‌گر هم هست.

   * نشانی‌ها از پیکربندی می‌آیند، نه از متن ثابتِ این قالب.
   ========================================================================= #}
<div class="float-contact" role="complementary" aria-label="راه‌های تماس سریع">

  <a class="float-contact__btn float-contact__btn--instagram"
     href="{{ contact.instagramUrl }}"
     target="_blank" rel="noopener noreferrer"
     aria-label="اینستاگرام ۲۰۰۸پارتس" title="اینستاگرام 2008parts">
    <svg class="float-contact__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" />
      <circle cx="12" cy="12" r="4.2" />
      <circle class="float-contact__dot" cx="17.4" cy="6.6" r="1.25" />
    </svg>
    <span class="float-contact__text">اینستاگرام</span>
  </a>

  <a class="float-contact__btn float-contact__btn--whatsapp"
     href="https://wa.me/{{ contact.whatsapp }}"
     target="_blank" rel="noopener noreferrer"
     aria-label="ارتباط در واتساپ" title="ارتباط در واتساپ">
    <svg class="float-contact__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      {# گوشیِ داخل حباب گفت‌وگو — شکل عمومی، نه آرم کپی‌شده. #}
      <path d="M21 11.6a8.6 8.6 0 0 1-12.9 7.5L3.5 20.5l1.4-4.5A8.6 8.6 0 1 1 21 11.6z" />
      <path d="M9.2 8.4c.3-.6.7-.6 1-.6h.5c.2 0 .4 0 .6.5l.7 1.6c.1.3 0 .5-.1.7l-.4.5c-.2.2-.2.3-.1.5a6 6 0 0 0 2.8 2.5c.2.1.4.1.6-.1l.5-.5c.2-.2.4-.2.6-.1l1.6.8c.3.2.4.3.4.5 0 .9-.6 1.7-1.5 1.8-.6.1-1.3 0-2.7-.6a9.6 9.6 0 0 1-4.9-4.9c-.5-1.2-.6-2-.4-2.7.1-.4.3-.8.5-1z" />
    </svg>
    <span class="float-contact__text">واتساپ</span>
  </a>

  <a class="float-contact__btn float-contact__btn--phone"
     href="tel:{{ contact.mobileTel }}"
     aria-label="تماس با فروشنده" title="تماس با فروشنده">
    <svg class="float-contact__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M6.3 3.5h3L10.6 7 8.8 8.8a12 12 0 0 0 6.4 6.4L17 13.4l3.5 1.3v3a2 2 0 0 1-2.2 2
               A15.5 15.5 0 0 1 4.3 5.7a2 2 0 0 1 2-2.2z" />
    </svg>
    <span class="float-contact__text">تماس</span>
  </a>

</div>
