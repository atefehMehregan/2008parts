{# نوار کناری فهرست: دسته‌ها و برندها با تعداد محصول.
   دستهٔ خالی هم با «۰» می‌آید — حذف بی‌سروصدایش، کاتالوگ را بزرگ‌تر از
   آنچه هست نشان می‌دهد. #}
{# ناوبری دسته‌ها.

   هر گروه یک <details> بومی است، نه جاوااسکریپت: پروژه هیچ اسکریپتی در
   مرورگر اجرا نمی‌کند و این تصمیم با یک منوی آکاردئونی شکسته نمی‌شود.
   <details> با صفحه‌کلید هم کار می‌کند و وضعیت باز/بسته را خودِ مرورگر
   نگه می‌دارد.

   روی دسکتاپ گروه‌ها همیشه باز دیده می‌شوند (CSS دکمه را پنهان و محتوا
   را آشکار می‌کند)، و روی موبایل جمع می‌شوند تا شبکهٔ محصول پایین
   رانده نشود. #}
<aside class="listing-sidebar" aria-label="پالایش کاتالوگ">
  <details class="filter-group" open>
    <summary class="filter-group__title">دسته‌بندی‌ها</summary>
    {% if categoryList.length %}
      <ul class="filter-list">
        {% for c in categoryList %}
          <li>
            <a class="{% if category and category.slug == c.slug %}is-current{% endif %}"
               href="/category/{{ c.slug | urlencode }}"
               {% if category and category.slug == c.slug %}aria-current="page"{% endif %}>
              <span>{{ c.name }}</span>
              <span class="filter-list__count num">{{ c.product_count | faDigits }}</span>
            </a>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="filter-group__empty">هنوز دسته‌بندی‌ای ثبت نشده است.</p>
    {% endif %}
  </details>

  <details class="filter-group">
    <summary class="filter-group__title">برندها</summary>
    {% if brandList.length %}
      <ul class="filter-list">
        {% for b in brandList %}
          <li>
            <a class="{% if activeBrand and activeBrand.slug == b.slug %}is-current{% endif %}"
               href="/brand/{{ b.slug | urlencode }}"
               {% if activeBrand and activeBrand.slug == b.slug %}aria-current="page"{% endif %}>
              <span>{{ b.name }}</span>
              <span class="filter-list__count num">{{ b.product_count | faDigits }}</span>
            </a>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="filter-group__empty">هنوز برندی ثبت نشده است.</p>
    {% endif %}
  </details>

  {# خودروها فقط وقتی نشان داده می‌شوند که واقعا ثبت شده باشند — یک
     بخش خالیِ «سازگاری» به مشتری چیزی نمی‌گوید. #}
  {% if vehicleList and vehicleList.length %}
    <details class="filter-group">
      <summary class="filter-group__title">سازگار با خودرو</summary>
      <ul class="filter-list">
        {% for v in vehicleList %}
          <li>
            <a class="{% if activeVehicle and activeVehicle.slug == v.slug %}is-current{% endif %}"
               href="{{ currentPath }}?vehicle={{ v.slug | urlencode }}"
               {% if activeVehicle and activeVehicle.slug == v.slug %}aria-current="page"{% endif %}>
              <span>{{ v.display_name }}</span>
              <span class="filter-list__count num">{{ v.product_count | faDigits }}</span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </details>
  {% endif %}
</aside>
