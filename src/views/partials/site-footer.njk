{# ============================================================================
   فوتر فروشگاه.

   هیچ اطلاعات کسب‌وکاری اینجا ساخته نمی‌شود: نه شماره تلفن، نه نشانی،
   نه ساعت کاری، نه شبکهٔ اجتماعی. تا وقتی مقدار واقعی‌اش را نداریم،
   جای آن را نگه می‌داریم و همین را صریح می‌گوییم.

   پیوندها فقط به صفحه‌هایی می‌روند که امروز واقعا کار می‌کنند.
   ========================================================================= #}
<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__col site-footer__brand">
      {# نسخهٔ معکوسِ نشان، چون زمینهٔ فوتر تیره است. #}
      {# همان نشان واقعیِ هدر. فوتر در هر دو پوسته تیره است، پس کاشیِ
         مات اینجا کمتر از هدر به چشم می‌آید. #}
      <img class="brand__mark" src="/img/brand/2008parts-logo.png" alt="" aria-hidden="true"
           width="40" height="40" />
      <p class="brand__name">{{ storeName }}</p>
      <p class="brand__latin">{{ storeNameLatin }}</p>
      <p class="site-footer__text">
        فروشگاه اینترنتی قطعات یدکی پژو ۲۰۰۸. قطعهٔ مورد نیازتان را با نام،
        کد کالا یا شماره فنی روی قطعه پیدا کنید.
      </p>
    </div>

    <div class="site-footer__col">
      <h2 class="site-footer__title">دسترسی سریع</h2>
      <ul class="site-footer__list">
        <li><a href="/">صفحهٔ اصلی</a></li>
        <li><a href="/products">همهٔ محصولات</a></li>
        <li><a href="/search">جست‌وجوی قطعه</a></li>
        <li><a href="/about">دربارهٔ ما</a></li>
        <li><a href="/contact">تماس با ما</a></li>
      </ul>
    </div>

    {# دسته‌ها از همان داده‌ای می‌آیند که نوار دستهٔ هدر استفاده می‌کند
       (res.locals.navCategories در src/app.js). پیوند واقعی است، نه فهرست
       تزئینی. شش تای اول کافی است؛ بقیه از «همهٔ محصولات» در دسترس‌اند. #}
    <div class="site-footer__col">
      <h2 class="site-footer__title">دسته‌بندی‌ها</h2>
      {% if navCategories.length %}
        <ul class="site-footer__list">
          {% for c in navCategories %}
            {% if loop.index <= 6 %}
              <li><a href="/category/{{ c.slug | urlencode }}">{{ c.name }}</a></li>
            {% endif %}
          {% endfor %}
          {% if navCategories.length > 6 %}
            <li><a href="/products">همهٔ دسته‌ها</a></li>
          {% endif %}
        </ul>
      {% else %}
        <p class="site-footer__note">هنوز دسته‌بندی‌ای ثبت نشده است.</p>
      {% endif %}
    </div>

    {# گروه برندها. از همان navBrands که هدر هم استفاده می‌کند (app.js)،
       پس همیشه با کاتالوگ هم‌خوان است.

       ⚠️ این‌ها برندِ *سازندهٔ قطعه*‌اند، نه خودروساز: بوش، مان، توتال،
       یوروریپار و «پژو سیتروئن». در این کاتالوگ برندی به نام «سیتروئن»،
       «DS» یا «فولکس» وجود ندارد و ساختنشان یعنی جعل داده — پیوند به
       برندی که نیست، پیوند مرده است. #}
    {% if navBrands.length %}
      <div class="site-footer__col">
        <h2 class="site-footer__title">برندها</h2>
        <ul class="site-footer__list">
          {% for b in navBrands %}
            <li><a href="/brand/{{ b.slug | urlencode }}">{{ b.name }}</a></li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}

    {# این سه مورد راهنما هستند، نه پیوند. با کلاس --plain ظاهرشان هم
       همین را می‌گوید تا کاربر بی‌جهت رویشان کلیک نکند. #}
    <div class="site-footer__col">
      <h2 class="site-footer__title">راهنمای پیدا کردن قطعه</h2>
      <ul class="site-footer__list site-footer__list--plain">
        <li>جست‌وجو با نام فارسی قطعه</li>
        <li>جست‌وجو با کد کالا</li>
        <li>جست‌وجو با شماره فنی (OEM)</li>
      </ul>
    </div>

    <div class="site-footer__col">
      <h2 class="site-footer__title">ارتباط با ما</h2>
      {# حالا صفحهٔ تماس وجود دارد، پس این ستون به آن پیوند می‌دهد.
         جملهٔ «هنوز ثبت نشده» می‌ماند تا وقتی که واقعا راه ارتباطی‌ای در
         پیکربندی ثبت شود — همان چیزی که خودِ صفحهٔ تماس هم می‌گوید. #}
      <p class="site-footer__note">
        راه‌های ارتباطی هنوز ثبت نشده‌اند و به‌محض نهایی شدن اعلام می‌شوند.
      </p>
      <ul class="site-footer__list">
        <li><a href="/contact">صفحهٔ تماس</a></li>
        <li><a href="/about">دربارهٔ ما</a></li>
      </ul>
    </div>
  </div>

  <div class="container site-footer__bottom">
    <p>© <span class="num">{{ year | faDigits }}</span> {{ storeName }} — همهٔ حقوق محفوظ است.</p>
    <p>ساخته‌شده برای دارندگان پژو ۲۰۰۸</p>
  </div>
</footer>
