# ---------------------------------------------------------------- وابستگی‌ها
node_modules/
npm-debug.log*
yarn-error.log*
.npm/

# --------------------------------------------------------------------- رازها
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json

# ------------------------------------------------- فایل‌های آپلودشده کاربران
# محتوای storage هرگز در Git نمی‌رود: فایل خصوصی مشتری و تصویر محصول است.
storage/*
!storage/.gitkeep
uploads/

# ------------------------------------------------- مانیفست واقعی تصویر محصول
# مانیفست تأییدشده شرایط تأمین‌کننده، شمارهٔ فاکتور (sourceRef)، نشانی منبع و
# ردِ تأیید حقوقی را نگه می‌دارد — دادهٔ تجاری، نه کد. در مخزن جایی ندارد.
# فایل *نمونه* عمدا ردگیری می‌شود: قالب را مستند می‌کند و هیچ دادهٔ واقعی ندارد.
scripts/data/product-image-manifest.js
!scripts/data/product-image-manifest.example.js

# ------------------------------------------------------------------ لاگ‌ها
logs/
*.log

# ------------------------------------------------------------ موقت و ساخت
tmp/
temp/
.cache/
dist/
build/
coverage/
*.tsbuildinfo

# ----------------------------------------------------------- سیستم‌عامل/ویرایشگر
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# --------------------------------------------------------- پشتیبان پایگاه داده
*.dump
*.sql.gz
backups/
